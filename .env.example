# ============================================================
# Credenciais AWS (Entrega 2 — Áudio)
# Copie para .env e preencha.  NUNCA versione o .env real.
#
# Alternativa recomendada: configurar o perfil com `aws configure`, que grava
# em ~/.aws/credentials. Nesse caso basta definir AWS_PROFILE e AWS_REGION aqui.
# ============================================================

# --- Região e perfil ---
AWS_REGION=us-east-1
# AWS_PROFILE=default

# --- Credenciais (só se NÃO usar ~/.aws/credentials) ---
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here

# --- Bucket para o Amazon Transcribe ---
# O Transcribe não aceita upload direto: o áudio precisa estar no S3.
AWS_S3_BUCKET=seu-bucket-coswara
