# ============================================================
# Credenciais Azure Cognitive Services (Entrega 2 — Áudio)
# Copie para .env e preencha.  NUNCA versione o .env real.
# ============================================================

# --- Azure Speech-to-Text ---
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=brazilsouth

# --- Azure Text Analytics (Language) ---
AZURE_LANGUAGE_KEY=your-language-key-here
AZURE_LANGUAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
